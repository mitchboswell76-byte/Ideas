{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:kit": "tsx scripts/build-single.ts kit.html dist-kit mandate-kit.html \"Mandate UI kit\"",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "soak": "tsx scripts/soak.ts",
    "build:preview": "tsx scripts/build-single.ts index.html dist-preview mandate-preview.html",
    "data": "tsx scripts/build-data.ts",
    "e2e": "npm run build && npm run build:preview && playwright test",
    "e2e:perf": "npm run build && npm run build:preview && playwright test --project=perf --no-deps"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/fiber": "^9.8.1",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-geo": "^3.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "polylabel": "^2.1.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "world-atlas": "^2.0.2"
  }
}
